<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Nook</string>
	<key>CFBundleName</key>
	<string>Nook</string>
	<!-- Export compliance: only standard HTTPS/TLS via Apple OS / Firebase — not proprietary crypto. -->
	<!-- App Store Connect equivalent: “None of the algorithms mentioned above”. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<!-- SwiftUI owns the app lifecycle; disable Firebase's AppDelegate swizzler (fixes I-SWZ001014). -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<!-- Keep Analytics quiet until AppDelegate enables collection after FirebaseApp.configure(). -->
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<key>FirebaseAutomaticScreenReportingEnabled</key>
	<false/>
</dict>
</plist>

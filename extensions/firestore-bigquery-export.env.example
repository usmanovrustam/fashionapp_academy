# Install in Firebase Console → Extensions:
# "Stream Firestore to BigQuery" (firebase/firestore-bigquery-export)
#
# Collection path suggestions (install once per collection, or use collection group):
#   users/{userId}/wardrobeItems
#   users/{userId}/analyticsEvents
#   users/{userId}/recommendations
#   users/{userId}/profile
#
# Dataset ID example:
DATASET_ID=sylyo_analytics
#
# Table ID prefix example:
TABLE_ID=sylyo
